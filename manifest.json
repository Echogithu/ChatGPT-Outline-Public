{
  "manifest_version": 3,
  "name": "ChatGPT Outline Navigator",
  "version": "0.1.9",
  "description": "ChatGPT 问题目录与答案大纲，支持左右布局或合并树形菜单。",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/content/dom-adapter.js",
        "src/content/history-loader.js",
        "src/content/sidebar.js",
        "src/content/message-outline.js",
        "src/content/index.js"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@chatgpt-outline",
      "strict_min_version": "157.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "配置会话目录布局",
    "default_popup": "src/options/options.html"
  }
}
